<resource_manager_info>
    <version>2.0</version>
    <config_params>
        <param key="native_audio_mode" value="multiple_mix_dsp"/>
        <param key="max_sessions" value="128"/>
        <param key="max_nonTunnel_sessions" value="4"/>
        <param key="logging_level" value ="3" />
        <param key="context_manager_enable" value ="false" />
        <param key="dual_mono" value ="false" />
        <param key="signal_handler" value ="false" />
    </config_params>
    <config_volume>
        <use_volume_set_param>0</use_volume_set_param>
        <supported_streams>
            <supported_stream>PAL_STREAM_ULTRA_LOW_LATENCY</supported_stream>
            <supported_stream>PAL_STREAM_COMPRESSED</supported_stream>
        </supported_streams>
    </config_volume>
    <config_lpm>
        <use_disable_lpm>1</use_disable_lpm>
        <lpm_supported_streams>
            <lpm_supported_stream>PAL_STREAM_LOW_LATENCY</lpm_supported_stream>
            <lpm_supported_stream>PAL_STREAM_ULTRA_LOW_LATENCY</lpm_supported_stream>
        </lpm_supported_streams>
    </config_lpm>
    <config_gapless key="gapless_supported" value="1"/>
    <config_max_sessions>
      <stream name="PAL_STREAM_LOW_LATENCY" max_size="8" />
      <stream name="PAL_STREAM_DEEP_BUFFER" max_size="10" />
      <stream name="PAL_STREAM_COMPRESSED" max_size="10" />
      <stream name="PAL_STREAM_VOIP" max_size="8" />
      <stream name="PAL_STREAM_VOIP_RX" max_size="8" />
      <stream name="PAL_STREAM_VOIP_TX" max_size="8" />
      <stream name="PAL_STREAM_VOICE_CALL_MUSIC" max_size="2" />
      <stream name="PAL_STREAM_GENERIC" max_size="2" />
      <stream name="PAL_STREAM_RAW" max_size="1" />
      <stream name="PAL_STREAM_VOICE_RECOGNITION" max_size="1" />
      <stream name="PAL_STREAM_VOICE_CALL_RECORD" max_size="2" />
      <stream name="PAL_STREAM_VOICE_CALL_TX" max_size="1" />
      <stream name="PAL_STREAM_VOICE_CALL_RX_TX" max_size="1" />
      <stream name="PAL_STREAM_VOICE_CALL" max_size="1" />
      <stream name="PAL_STREAM_LOOPBACK" max_size="8" />
      <stream name="PAL_STREAM_TRANSCODE" max_size="8" />
      <stream name="PAL_STREAM_VOICE_UI" max_size="8" />
      <stream name="PAL_STREAM_PCM_OFFLOAD" max_size="2" />
      <stream name="PAL_STREAM_ULTRA_LOW_LATENCY" max_size="8" />
      <stream name="PAL_STREAM_PROXY" max_size="1" />
    </config_max_sessions>
    <gain_db_to_level_mapping>
        <gain_level_map db="-59" level="5"/>
        <gain_level_map db="-17.4" level="4"/>
        <gain_level_map db="-13.8" level="3"/>
        <gain_level_map db="-10.2" level="2"/>
        <gain_level_map db="0" level="1"/>
    </gain_db_to_level_mapping>
    <device_profile>
        <in-device>
            <id>PAL_DEVICE_IN_WIRED_HEADSET</id>
            <back_end_name>MI2S-LPAIF-TX-SECONDARY</back_end_name>
            <max_channels>4</max_channels>
            <channels>1</channels>
            <samplerate>48000</samplerate>
            <snd_device_name>headphone-mic</snd_device_name>
            <ec_enable>0</ec_enable>
            <usecase>
                <name>PAL_STREAM_DEEP_BUFFER</name>
                <ec_enable>1</ec_enable>
            </usecase>
            <usecase>
                <name>PAL_STREAM_COMPRESSED</name>
                <ec_enable>1</ec_enable>
            </usecase>
            <usecase>
                <name>PAL_STREAM_VOIP_TX</name>
                <ec_enable>1</ec_enable>
            </usecase>
            <ec_rx_device>
                <id>PAL_DEVICE_OUT_SPEAKER</id>
            </ec_rx_device>
        </in-device>
        <out-device>
            <id>PAL_DEVICE_OUT_WIRED_HEADSET</id>
            <back_end_name>MI2S-LPAIF-RX-SECONDARY</back_end_name>
            <max_channels>4</max_channels>
            <channels>2</channels>
            <samplerate>48000</samplerate>
            <snd_device_name>headphone-out</snd_device_name>
            <speaker_protection_enabled>0</speaker_protection_enabled>
            <fractional_sr>0</fractional_sr>
            <!-- To enable external EC reference the flag extec_ref_enabled must be added as 1 -->
            <ext_ec_ref_enabled>0</ext_ec_ref_enabled>
            <cps_mode>0</cps_mode>
            <!--specify the supported bit format on speaker end point -->
            <!--this should be in the form of pal_audio_fmt_id-->
            <!--e.g <supported_bit_format >PAL_AUDIO_FMT_PCM_S24_LE</supported_bit_format>-->
            <supported_bit_format>PAL_AUDIO_FMT_PCM_S16_LE</supported_bit_format>
            <is32BitSupported>0</is32BitSupported>
            <!-- RAS should be enabled with speaker protection always -->
            <ras_enabled>0</ras_enabled>
            <!-- Time in seconds for Quick cal. Set 0 to disable -->
            <quick_cal_time>0</quick_cal_time>
            <usecase>
                <name>PAL_STREAM_LOW_LATENCY</name>
            </usecase>
        </out-device>
    </device_profile>
</resource_manager_info>
